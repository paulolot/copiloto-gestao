# Ponte MCP — variáveis de ambiente
# Copie para .env e preencha os valores REAIS (nunca versionar .env)

# Token de acesso para a ponte MCP (gerado aleatoriamente; o Grok Bot usa no cabeçalho).
# A ponte não inicia sem ele nem com o valor de exemplo abaixo
PONTE_TOKEN=troque_por_token_aleatorio_forte

# Porta em que a ponte escuta (padrão 3333)
PONTE_PORT=3333

# Caminho do arquivo do banco (auditoria + fila); gravado a cada escrita. Sem ele, os dados somem ao reiniciar
DB_PATH=./copiloto.db

# Caminho raiz do vault na máquina do Paulo
VAULT_PATH=/caminho/para/o/vault

# Token do bot do Discord
DISCORD_BOT_TOKEN=token_do_discord_developer_portal

# ID do servidor (guild) do Discord
DISCORD_GUILD_ID=id_do_servidor

# ID do usuário do Paulo no Discord (único autorizado a aprovar)
DISCORD_OWNER_ID=id_do_paulo_no_discord

# IDs dos canais do Discord (pegar no canal com botão direito → Copiar ID)
DISCORD_CANAL_BRIEFING=
DISCORD_CANAL_ALERTAS=
DISCORD_CANAL_APROVACOES=
DISCORD_CANAL_REUNIOES=
DISCORD_CANAL_PESSOAS=
DISCORD_CANAL_CTO=

# --- Fase 1: Azure DevOps (somente leitura) ---
# Organização e Personal Access Token com escopo só de leitura (Work Items, Code, Analytics). Nunca versionar o token
AZDO_ORG=metanetsistema
AZDO_PAT=
# Nome técnico dos campos personalizados (confira em Process → campo → Reference name)
AZDO_CAMPO_PARALISADO=Custom.Status
AZDO_CAMPO_TIPO_BUG=Custom.TipoBug
# Colunas do board que não entram em nenhuma métrica (padrão: Ideias,UX)
# AZDO_COLUNAS_IGNORADAS=Ideias,UX
# Começo do nome da tag que marca os itens de um roadmap (padrão: roadmap)
# AZDO_TAG_ROADMAP=roadmap
# Times sincronizados, separados por vírgula: fiscal, desktop, retaguarda (padrão: só fiscal)
AZDO_TIMES=fiscal
# nao = desliga a sincronização de hora em hora (as ferramentas continuam funcionando sob demanda)
AZDO_SYNC_AGENDADO=sim

# Limites de alerta (opcional; sem eles valem os padrões do plano e a linha de base de 8 semanas)
# LIMITE_ENVELHECIMENTO_DIAS=7
# LIMITE_BLOQUEIO_DIAS_UTEIS=2
# LIMITE_WIP_PESSOA=3
# LIMITE_BUG_RATE_PERCENT=10
# LIMITE_COMMIT_PARADO_DIAS_UTEIS=3
